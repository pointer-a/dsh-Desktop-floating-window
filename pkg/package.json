{
  "name": "dsh-taskbox",
  "version": "0.1.0",
  "description": "DSH（DeepSeek Harness）桌面端插件：Windows 桌面上始终置顶的任务浮窗，实时显示各对话运行状态，需要授权/选择时直接在小窗里点选，点一下唤回主窗口。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop",
    "widget",
    "approval",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pointer-a/dsh-Desktop-floating-window.git",
    "directory": "pkg"
  },
  "homepage": "https://github.com/pointer-a/dsh-Desktop-floating-window#readme",
  "bugs": "https://github.com/pointer-a/dsh-Desktop-floating-window/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node ../test/host-selftest.mjs && node ../test/race-selftest.mjs",
    "prepublishOnly": "node ../test/host-selftest.mjs && node ../test/race-selftest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

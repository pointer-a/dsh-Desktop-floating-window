{
  "manifestVersion": "1.0.0",
  "providerId": "io.github.pointer-a.dsh-Desktop-floating-window",
  "name": "dsh-taskbox",
  "description": "Pins a small always-on-top box to the Windows desktop: live status for every conversation, inline answers for pending approvals and questions, and one click to bring the main window back.",
  "homepage": "https://github.com/pointer-a/dsh-Desktop-floating-window",
  "attribution": {
    "name": "pointer-a",
    "url": "https://github.com/pointer-a"
  },
  "transport": {
    "kind": "https-json",
    "endpoint": "https://pointer-a.github.io/dsh-Desktop-floating-window/v1/plugins.json",
    "method": "GET"
  },
  "query": {
    "supported": [
      "q",
      "category",
      "cursor",
      "limit"
    ],
    "defaultLimit": 50,
    "maxLimit": 50,
    "sorts": []
  }
}
